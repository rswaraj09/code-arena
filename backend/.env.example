# --- Profile ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Database (only used when SPRING_PROFILES_ACTIVE=prod — dev profile uses in-memory H2) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=codearena
DB_USERNAME=codearena
DB_PASSWORD=codearena

# --- JWT ---
# Generate a real one with: openssl rand -base64 48
JWT_SECRET=change-this-dev-secret-change-this-dev-secret-please
JWT_ACCESS_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_MS=604800000

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Judge sandbox ---
JUDGE_WORKDIR=/tmp/codearena-submissions
JUDGE_TIMEOUT_SECONDS=10
JUDGE_MEMORY_MB=256
JUDGE_CPU_LIMIT=1
JUDGE_PIDS_LIMIT=64
